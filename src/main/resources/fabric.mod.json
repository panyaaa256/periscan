{
	"schemaVersion": 1,
	"id": "periscan",
	"version": "${version}",
	"name": "PeriScan",
	"description": "Highlights blocks that must be removed before running a trencher / world eater, from chunk coordinates and config only.",
	"authors": [
		"panyaaa256"
	],
	"contact": {
		"homepage": "https://github.com/panyaaa256/periscan",
		"sources": "https://github.com/panyaaa256/periscan",
		"issues": "https://github.com/panyaaa256/periscan/issues"
	},
	"license": "MIT",
	"icon": "assets/periscan/icon.png",
	"environment": "client",
	"accessWidener": "periscan.accesswidener",
	"mixins": [
		{
			"config": "periscan.client.mixins.json",
			"environment": "client"
		}
	],
	"entrypoints": {
		"client": [
			"com.panyaaa256.periscan.PeriScanClient"
		],
		"modmenu": [
			"com.panyaaa256.periscan.integration.modmenu.PeriScanModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*",
		"yet_another_config_lib_v3": "${yacl}"
	},
	"suggests": {
		"litematica": "*",
		"modmenu": "*"
	}
}
